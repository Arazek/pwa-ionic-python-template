# =============================================================================
# PWA Template — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Unique name for this project — used as Traefik router prefix (no spaces, lowercase)
APP_NAME=myapp
DOMAIN=myapp.localhost
# TLS mode: local (self-signed) | letsencrypt
TLS_MODE=local
ACME_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myapp

# Keycloak gets its own database on the same postgres instance
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Internal URL used by backend to verify tokens (container-to-container)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Public URL — must match the `iss` claim in tokens (the URL the browser uses to reach Keycloak)
# Local dev: http://localhost:8080/auth   (direct, no TLS)
# Production: https://yourdomain.com/auth (via Traefik)
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
KEYCLOAK_REALM=myapp

# Social Identity Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
SECRET_KEY=changeme-use-openssl-rand-hex-32
# Local dev: include http://localhost:4200 (ng serve)
# Production: include only your HTTPS domain
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://localhost:8000"]
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=changeme
